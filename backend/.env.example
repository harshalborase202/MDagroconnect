# MD Agro Connect — Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ─── Server ───────────────────────────────────────────
PORT=3001

# ─── MySQL Database ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=mdagroconnect

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─── Google Gemini AI ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Administrator Credentials ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@mdagro2026

# ─── JWT Authentication ─────────────────────────────────
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# ─── Firebase Cloud Firestore ───────────────────────────
# Place serviceAccountKey.json in the backend/ folder or define below:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json

